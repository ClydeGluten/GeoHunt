    "@types/react-dom": "^19.1.9",
    "@types/qrcode": "^1.5.5",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.4",
    "vitest": "^3.2.4"
  }
