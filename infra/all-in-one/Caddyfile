{
	admin off
}

{$SITE_ADDRESS::80} {
	encode zstd gzip

	handle /api/* {
		reverse_proxy 127.0.0.1:3000
	}

	handle /socket.io* {
		reverse_proxy 127.0.0.1:3000
	}

	handle /bot/webhook {
		reverse_proxy 127.0.0.1:3001
	}

	handle {
		root * /srv/geohunter/web
		try_files {path} /index.html
		file_server
	}

	@app_shell path / /index.html /sw.js /manifest.webmanifest
	header @app_shell Cache-Control "no-cache, no-store, must-revalidate"

	@versioned_assets path /assets/*
	header @versioned_assets Cache-Control "public, max-age=31536000, immutable"

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "geolocation=(self), camera=(), microphone=()"
		-Server
	}
}
