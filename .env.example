# Public HTTPS address. Telegram requires a publicly reachable HTTPS URL.
COMPOSE_PROJECT_NAME=geohunter
# quick: automatic temporary trycloudflare.com URL; named: Cloudflare tunnel token; disabled: direct/local Caddy.
TUNNEL_MODE=disabled
CLOUDFLARED_TUNNEL_TOKEN=
SITE_ADDRESS=:80
WEB_PORT=8080
HTTPS_PORT=8443
POSTGRES_DEV_PORT=55432
PUBLIC_WEBAPP_URL=http://localhost:8080
PUBLIC_BASE_URL=http://localhost:8080
CORS_ORIGIN=http://localhost:8080,http://127.0.0.1:8080
MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Obtain this from @BotFather. Do not commit the real value.
BOT_TOKEN=123456789:replace-with-a-real-telegram-bot-token
BOT_WEBHOOK_SECRET=replace-with-at-least-32-random-characters
BOT_SERVICE_TOKEN=replace-with-a-different-32-character-secret
BOT_MODE=disabled
BOT_POLLING_START_DELAY_SECONDS=35

POSTGRES_DB=geohunter
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=replace-admin-password
MIGRATOR_DB_PASSWORD=replace-migrator-password
APP_DB_PASSWORD=replace-runtime-password
MCP_DB_PASSWORD=replace-readonly-password
REDIS_PASSWORD=replace-redis-password

# Local browser development only. Keep false in production.
NODE_ENV=development
DEV_AUTH_ENABLED=true
COOKIE_SECURE=false
SESSION_DAYS=30
LOG_LEVEL=info
